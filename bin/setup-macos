#! /usr/bin/env bash

NIX_BASH_PATH="$HOME/.nix-profile/bin/bash"

if [ "$(command -v bash)" != "$NIX_BASH_PATH" ]; then
    if ! install-nix-pkgs; then
        echo "Could not install nix packages! Is nix installed?" >&2

        exit 1
    fi
fi

# Ensure I'm using bash, because I'm just not a zsh guy.
cur_shell="$(dscl . -read "$HOME" UserShell)"
if [ "$cur_shell" -ne "$NIX_BASH_PATH" ]; then
    sudo chsh -s "$NIX_BASH_PATH"
fi

# The settings I've customized with the macOS `defaults` CLI tool.
#
# `defaults` is useful for more than just macOS built-in features - you can
# manipulate app preferences generally with it.
#
# You have to log out for some of the changes to take effect. Not sure if
# that's true for all of them or just the macOS builtins yet.
#
# A useful tutorial on working with the defaults command can be found here:
# https://www.shell-tips.com/mac/defaults/.
#
# In summary, you can use `defaults domains | tr , '\n'` to figure out what
# apps are available to manipulate, and `defaults read <domain>` to see all set
# preferences for an app. Turn on a preference in the target app manually, use
# `defaults <domain> read` to see how it's named in the plist file, then slap
# the result in here so it's easy to apply on future Macs.
#
# TODO Set up a tab completer for 'defaults read' to complete available domains.

# The dock is a waste of screen space.
defaults write com.apple.dock autohide -int 1
defaults write com.apple.dock orientation left

# Have Finder show files whose names begin with '.'. Occasionally makes it
# easier for me to grab something (usually in file dialog boxes).
defaults write com.apple.Finder AppleShowAllFiles -bool true

# Do not show me the accent menu popup when I'm holding down a key.
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

# Make key repeat a little faster than the GUI will let you set it.
defaults write NSGlobalDomain KeyRepeat -int 1

# Let me tap for clicks.
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true

# Let me tap for drags instead of having to press down hard while dragging.
defaults write com.apple.AppleMultitouchTrackpad Dragging -bool true

# Let me double-tap for drags so I can pick my fingers up mid-drag.
defaults write com.apple.AppleMultitouchTrackpad DragLock -bool true

# Turn off that darned translucent menubar.
defaults write com.apple.universalaccess reduceTransparency -int 1

# DON'T GIVE ME HOTCORNERS.
defaults write com.apple.dock wvous-tl-corner -int 0
defaults write com.apple.dock wvous-tr-corner -int 0
defaults write com.apple.dock wvous-bl-corner -int 0
defaults write com.apple.dock wvous-br-corner -int 0

# Who actually writes RTFs?
#
# ...okay, I did. Years ago. But not any more.
defaults write com.apple.TextEdit "RichText" -bool "false"

# Don't put screenshots on my desktop. :P
mkdir -p "$HOME/Documents/Screenshots"
defaults write com.apple.screencapture location "$HOME/Documents/Screenshots"
defaults write com.apple.screencapture show-thumbnail -bool false


if ! command -v brew; then
    /usr/bin/env bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Assumes Apple Silicon.
    #
    # Since I mostly use macOS for employers, that's a pretty safe bet -
    # nobody's giving devs Intel Macs these years.
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Set up Hammerspoon defaults.
brew install hammerspoon --cask
add-login-item '/Applications/Hammerspoon.app'


# Install the little timer app I use.
brew install michaelvillar-timer

# Shortcat does a pretty solid job of letting you avoid the mouse.
#
# I do still use the mouse occasionally, but I don't know that I actually need
# to.
brew install shortcat
add-login-item '/Applications/Shortcat.app'
defaults write com.sproutcube.Shortcat KeyboardShortcuts_toggleShortcat \
         "'"'{"carbonKeyCode":49,"carbonModifiers":4864}'"'"

# TODO Specify that aw-server, aw-watcher-afk, and aw-watcher-window should all
# be active. I've at least once seen it not have aw-watcher-window active.
brew install activitywatch --cask
add-login-item '/Applications/ActivityWatch.app'

# Install Karabiner-Elements, for custom keybindings - it should automatically
# pick up the bindings from the .config directory after install is finished.
brew install --cask karabiner-elements
add-login-item /Applications/Karabiner-Elements.app

# Set up multi-item clipboard.
brew install maccy
add-login-item '/Applications/Maccy.app'
defaults write org.p0deje.Maccy KeyboardShortcuts_popup '{"carbonKeyCode":9,"carbonModifiers":4608}'
defaults write org.p0deje.Maccy pasteByDefault 1
defaults write org.p0deje.Maccy SUEnableAutomaticChecks 1

# I will fight "natural" scrolling on desktop computers until the day I die.
brew install scroll-reverser --cask
defaults write com.pilotmoon.scroll-reverser InvertScrollingOn -int 1
defaults write com.pilotmoon.scroll-reverser StartAtLogin -int 1
defaults write com.pilotmoon.scroll-reverser ReverseX -int 1
add-login-item '/Applications/Scroll Reverser.app'

# Hidden Bar helps tame the endless pileup of menubar items, by keeping the
# ones you specify hidden until you ask for them to be shown.
brew install hiddenbar --cask
defaults write com.dwarvesv.minimalbar isAutoStart = 1
defaults write com.dwarvesv.minimalbar isAutoHide = 1
add-login-item '/Applications/Hidden Bar.app'

# Set up a todo.txt client. Someday I'll move over to Emacs for it, but none of
# the todo.txt modes I've tried so far filled me with joy.
brew install sleek-app --cask
add-login-item '/Applications/sleek.app'

# Avoiding blue light is supposed to help late at night. If nothing else, it at
# least makes handling 3 AM pages much less miserable.
#
# Thus, turn it on by default on macOS.
brew install smudge/smudge/nightlight
nightlight on
nightlight schedule start
nightlight temp 75

# Deselect the "Save in Keychain" checkbox in gpg's pinentry-mac dialog.
defaults write org.gpgtools.common UseKeychain NO

# Dark mode, generally.
set-dark-mode true

# Set up preferences for activitywatch.
activitywatch_watcher_prefs_path="$HOME/Library/Application Support/activitywatch"
echo '[aw-watcher-afk]
timeout = 300' > "$activitywatch_watcher_prefs_path/aw-watcher-afk/aw-watcher-afk.toml"
